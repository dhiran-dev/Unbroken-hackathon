{
  "name": "pulserank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "bun --bun next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run release:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "collect:run": "bun scripts/run-collection.ts",
    "collect:pulse": "bun scripts/run-pulserank-collection.ts",
    "verify:pulse-backend": "bun scripts/verify-pulserank-backend.ts",
    "worker": "bun src/worker/index.ts",
    "worker:pulse": "bun src/worker/pulse-worker.ts",
    "release:check": "bun scripts/release-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@brightdata/cli": "0.3.2",
    "better-auth": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "gtfs-realtime-bindings": "2.2.0",
    "lucide-react": "1.32.0",
    "maplibre-gl": "6.4.1",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.3.11",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "drizzle-kit": "0.31.9",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
