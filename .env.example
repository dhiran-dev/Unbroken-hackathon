# Public application URL. Never commit .env.local or production values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Optional deployment metadata; the application uses NEXT_PUBLIC_APP_URL and
# BETTER_AUTH_URL for runtime behavior.
PRODUCTION_APP_URL=

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# PostgreSQL connection URL. Production must require TLS.
DATABASE_URL=

# Bright Data Scraper Studio custom collector
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_COLLECTOR_ID=c_msyjsllt1r9ej5tdub
BRIGHTDATA_ACCESSIBILITY_ADVISORIES_COLLECTOR_ID=c_mt00zyx63815q2j9g
BRIGHTDATA_STOP_RELOCATIONS_COLLECTOR_ID=c_mt01m8hghrt0swozl
BRIGHTDATA_ACCESSIBLE_STOPS_COLLECTOR_ID=c_mt0719p0vuntmudm6
SFMTA_SOURCE_URL=https://www.sfmta.com/elevator-status/elevatorstatus.php?src=prod

# Citywide Muni schedule data. Keep the API token blank in source control.
CITYWIDE_DATA_ENABLED=false
TRANSIT_511_API_TOKEN=
TRANSIT_511_OPERATOR_ID=SF
TRANSIT_511_GTFS_URL=https://api.511.org/transit/datafeeds
TRANSIT_DATA_DIR=/data/transit

# Fireworks AI review
FIREWORKS_API_KEY=
FIREWORKS_API_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
FIREWORKS_REASONING_EFFORT=high

# Private healing evidence. Use a persistent worker volume in production.
INCIDENT_ARTIFACTS_DIR=artifacts/incidents

# One-time bootstrap command inputs. Remove after use.
OWNER_EMAIL=
OWNER_PASSWORD=
JUDGE_ADMIN_EMAIL=
JUDGE_ADMIN_PASSWORD=
