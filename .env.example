# PulseRank environment contract (L1 cleanup batch).
# Never commit .env.local or production values.

# Public application URL (origin checks, canonical links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection URL. Production must require TLS.
DATABASE_URL=

# Bright Data Scraper Studio — PulseRank product collector only.
# The retired UNBROKEN collector identity is audit history (see AGENTS.md)
# and must never be configured here.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_COLLECTOR_ID=c_mt2yacvcyvyvim56d

# Fireworks AI advisory review
FIREWORKS_API_KEY=
FIREWORKS_API_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
FIREWORKS_REASONING_EFFORT=high

# Private incident/healing evidence. Use a persistent worker volume in production.
INCIDENT_ARTIFACTS_DIR=artifacts/incidents

# PulseRank runtime flags — every surface defaults to false (fail-closed).
PULSERANK_APP_ENABLED=false
PULSERANK_COLLECTION_ENABLED=false
PULSERANK_DISCOVERY_ENABLED=false
